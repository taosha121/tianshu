{
  "name": "agent-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && cp static/index.html static/manifest.json dist/",
    "start": "npm run build && ui5 serve",
    "watch": "tsc --watch",
    "serve": "ui5 serve",
    "dev": "npm run build && npm-run-all --parallel watch serve"
  },
  "ui5": {
    "dependencies": [
      "ui5-middleware-livereload"
    ]
  },
  "devDependencies": {
    "@ui5/cli": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "ui5-middleware-livereload": "^3.4.0"
  },
  "dependencies": {
    "@sap/galilei": "*",
    "@sap/galilei-ui5": "*"
  }
}
